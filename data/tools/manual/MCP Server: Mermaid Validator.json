[
    {
        "name": "mermaid-validator_validateMermaid",
        "description": "Validates a Mermaid diagram and returns the rendered image (PNG or SVG) if valid",
        "parameters": {
            "type": "object",
            "properties": {
                "diagram": {
                    "type": "string"
                },
                "format": {
                    "type": "string",
                    "enum": [
                        "svg",
                        "png"
                    ],
                    "default": "png"
                }
            },
            "required": [
                "diagram"
            ],
            "additionalProperties": false,
            "$schema": "http://json-schema.org/draft-07/schema#"
        }
    }
]